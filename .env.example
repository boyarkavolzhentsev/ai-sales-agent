# Configuration reference for `python -m app.runtime`. Placeholders only: never put a real
# credential in this file. The runtime reads the process environment only (this file is
# not loaded automatically); export the variables, or copy this file to `.env` (gitignored)
# and load it with your shell or process manager. See docs/deployment.md (operations) and
# docs/integrations.md (providers). Production: SALES_AGENT_MODE=production requires email,
# LLM, Telegram, LOCAL knowledge and embeddings to be configured.

# --- Core (required) ---
SALES_AGENT_MODE=local
SALES_AGENT_DATABASE_PATH=.local/data/sales-agent.sqlite3
SALES_AGENT_SENDER_NAME=Example Seller
SALES_AGENT_COMPANY_NAME=Example Company
SALES_AGENT_MAILBOXES=sales@example.com
SALES_AGENT_TIMEZONE=Europe/Kyiv
SALES_AGENT_WINDOW_DAYS=MON,TUE,WED,THU,FRI
SALES_AGENT_WINDOW_START=09:00
SALES_AGENT_WINDOW_END=18:00
SALES_AGENT_MAX_SENDS_PER_DAY=20
SALES_AGENT_MAX_NEW_CONTACTS_PER_DAY=20
SALES_AGENT_MAX_FOLLOW_UPS_PER_DAY=20
SALES_AGENT_MAX_FOLLOW_UPS_PER_CONTACT=2
SALES_AGENT_MIN_FOLLOW_UP_INTERVAL_HOURS=48
# Emergency stop for every send. Start a new deployment with it ON and switch it off only
# after deployment-check and a controlled smoke test.
SALES_AGENT_KILL_SWITCH=true
SALES_AGENT_KILL_SWITCH_REASON=new deployment: not yet verified
SALES_AGENT_OPERATOR_IDS=operator-1

# --- Worker / runtime (optional) ---
# SALES_AGENT_APP_ID=ai-sales-agent
# SALES_AGENT_CODE_VERSION=local
# SALES_AGENT_WORKER_ID=local-worker
# SALES_AGENT_BATCH_LIMIT=25
# SALES_AGENT_POLICY_VERSION=env-1

# --- Providers (optional; NONE selects nothing and needs nothing) ---
# Settings for a provider that is not selected are rejected, never ignored.
SALES_AGENT_EMAIL_PROVIDER=NONE
SALES_AGENT_LLM_PROVIDER=NONE
SALES_AGENT_OPERATOR_PROVIDER=NONE
SALES_AGENT_KNOWLEDGE_PROVIDER=LOCAL
SALES_AGENT_EMBEDDINGS_PROVIDER=NONE

# Email: GMAIL (Stage 16; see docs/integrations.md). Credential files belong under .local/credentials/.
# SALES_AGENT_GMAIL_ADDRESS=sales@example.com
# SALES_AGENT_GMAIL_TOKEN_FILE=.local/credentials/gmail-token.json
# SALES_AGENT_GMAIL_CREDENTIALS_FILE=.local/credentials/gmail-oauth-client.json
# SALES_AGENT_GMAIL_POLL_INTERVAL_SECONDS=60
# SALES_AGENT_GMAIL_TIMEOUT_SECONDS=30
# Secrets (instead of the credentials file):
# SALES_AGENT_GMAIL_CLIENT_ID=
# SALES_AGENT_GMAIL_CLIENT_SECRET=
# SALES_AGENT_GMAIL_REFRESH_TOKEN=

# LLM: OPENAI | ANTHROPIC | GEMINI (Stage 18; see docs/integrations.md)
# SALES_AGENT_LLM_MODEL=
# SALES_AGENT_LLM_TIMEOUT_SECONDS=30
# SALES_AGENT_LLM_MAX_OUTPUT_TOKENS=4096
# SALES_AGENT_LLM_API_KEY=

# Operator channel: TELEGRAM (Stage 17; see docs/integrations.md)
# SALES_AGENT_TELEGRAM_OPERATOR_CHAT_IDS=111111111=operator-1
# SALES_AGENT_TELEGRAM_TIMEOUT_SECONDS=20
# SALES_AGENT_TELEGRAM_BOT_TOKEN=

# Knowledge: LOCAL (the approved knowledge index; directory optional, ingested by knowledge-index)
# SALES_AGENT_KNOWLEDGE_DIR=knowledge_base

# Embeddings: OPENAI | GEMINI (Stage 19; required in production, optional locally; semantic retrieval;
# independent of the LLM provider; its own key). See docs/integrations.md.
# SALES_AGENT_EMBEDDINGS_MODEL=
# SALES_AGENT_EMBEDDINGS_DIMENSIONS=
# SALES_AGENT_EMBEDDINGS_TIMEOUT_SECONDS=30
# SALES_AGENT_EMBEDDINGS_MIN_SIMILARITY=0.30
# SALES_AGENT_EMBEDDINGS_API_KEY=
